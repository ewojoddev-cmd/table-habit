# TableHabit Firebase web config.
#
# Copy to .env.local for development:
#   cp .env.example .env.local
#
# Values: Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# The same names are read by the GitHub Pages build (see .github/workflows/deploy.yml),
# where they come from repository secrets instead of a file.
#
# These values are *identifiers*, not secrets: the Firebase web config is public and
# ships inside every browser bundle. Real protection comes from firestore.rules, the
# Google Cloud API-key restrictions and disabling Auth sign-ups — see the README.
NEXT_PUBLIC_FIREBASE_API_KEY=''
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN='<project>.firebaseapp.com'
NEXT_PUBLIC_FIREBASE_PROJECT_ID='<project-id>'
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET='<project>.firebasestorage.app'
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=''
NEXT_PUBLIC_FIREBASE_APP_ID=''
# Optional: Google Analytics for Firebase.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=''
